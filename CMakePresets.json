{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "profile",
      "displayName": "Optimized with debug information",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "cpu-only",
      "displayName": "Release without GPU runtime support",
      "inherits": "release",
      "cacheVariables": {
        "Q3MAPX_ENABLE_OPENCL": "OFF"
      }
    },
    {
      "name": "cli",
      "displayName": "Release CLI without Qt",
      "inherits": "release",
      "cacheVariables": {
        "Q3MAPX_BUILD_GUI": "OFF"
      }
    },
    {
      "name": "sanitized",
      "displayName": "Linux address/undefined behavior checks",
      "inherits": "debug",
      "cacheVariables": {
        "Q3MAPX_ENABLE_SANITIZERS": "ON",
        "Q3MAPX_ENABLE_OPENCL": "OFF",
        "Q3MAPX_BUILD_GUI": "OFF",
        "CMAKE_C_FLAGS_DEBUG": "-g -O1",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "profile",
      "configurePreset": "profile"
    },
    {
      "name": "cpu-only",
      "configurePreset": "cpu-only"
    },
    {
      "name": "cli",
      "configurePreset": "cli"
    },
    {
      "name": "sanitized",
      "configurePreset": "sanitized"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-only",
      "configurePreset": "cpu-only",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cli",
      "configurePreset": "cli",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitized",
      "configurePreset": "sanitized",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    }
  ]
}
